[flake8]
max-line-length = 89
extend-ignore = E203, E266, E501, W503, E402
max-complexity = 10
exclude =
    .git,
    __pycache__,
    docs/source/conf.py,
    old,
    build,
    dist,
    .eggs,
    *.egg,
    work/,
    out/
per-file-ignores =
    __init__.py:F401,F403
    tests/*:F401,F403,E501
